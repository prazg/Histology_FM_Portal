  "patch": {
   "label": "Patch encoders",
   "blurb": "Self-supervised vision encoders that turn each tile into an embedding."
  },
  "vl": {
   "label": "Vision–language",
   "blurb": "Image and text in one space: zero-shot classification with your own prompts."
  },
  "slide": {
   "label": "Slide encoders",
   "blurb": "Aggregate patch embeddings into one vector per slide."
  },
  "vmif": {
   "label": "Virtual multiplex",
   "blurb": "Predict protein marker maps (mIF / CODEX) from H&E."
  },
  "st": {
   "label": "Spatial transcriptomics",
   "blurb": "Predict spot-level gene expression from H&E."
  },
  "seg": {
   "label": "Tissue segmentation",
   "blurb": "Separate tissue from background before patching."
  }
 },
 "tasks": {
  "embed_tiles": {
   "label": "Embed tiles",
   "input": "tiles",
   "outputs": [
    "Embeddings (.h5)",
    "PCA map coloured by k-means cluster",
    "Cosine-similarity matrix"
   ]
  },
  "embed_wsi": {
   "label": "Embed a slide",
   "input": "wsi",
   "outputs": [
    "Patch embeddings (.h5, TRIDENT format)",
    "Spatial k-means cluster map",
    "PCA-as-RGB map"
   ]
  },
  "zeroshot_tiles": {
   "label": "Zero-shot classify tiles",
   "input": "tiles",
   "outputs": [
    "Class probabilities per tile",
    "Per-tile bar chart"
   ]
  },
  "zeroshot_wsi": {
   "label": "Zero-shot map a slide",
   "input": "wsi",
   "outputs": [
    "Per-class probability heatmaps",
    "Predicted-class map",
    "Slide-level class scores"
   ]
  },
  "slide_embed": {
   "label": "Slide embedding",
   "input": "wsi",
   "outputs": [
    "Slide vector (.h5)",
    "Tissue contour preview"
   ]
  },
  "slide_zeroshot": {
   "label": "Zero-shot classify a slide",
   "input": "wsi",
   "outputs": [
    "Slide-level class scores",
    "Slide vector"
   ]
  },
  "vmif_tiles": {
   "label": "Virtual multiplex on tiles",
   "input": "tiles",
   "outputs": [
    "Marker maps per tile",
    "Marker intensity matrix"
   ]
  },
  "vmif_wsi": {
   "label": "Virtual multiplex on a slide",
   "input": "wsi",
   "outputs": [
    "Per-marker spatial maps",
    "Marker summary table",
    "Predictions (.h5 / .csv)"
   ]
  },
  "st_wsi": {
   "label": "Predict spatial expression",
   "input": "wsi",
   "outputs": [
    "Spot × gene AnnData (.h5ad)",
    "Gene expression maps"
   ]
  },
  "segment_wsi": {
   "label": "Segment tissue",
   "input": "wsi",
   "outputs": [
    "Contour overlay",
    "GeoJSON (opens in QuPath)"
   ]
  }
